# LF everywhere so scripts and configs work inside Linux containers and on the VM
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.onnx binary
*.gz binary

# Recorded HTTP responses are kept byte for byte (tests/fixtures/canned_claim/README.md)
tests/fixtures/**/literature/* -text
