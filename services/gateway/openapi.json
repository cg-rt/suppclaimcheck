    "/llm/structured": {
      "post": {
        "description": "One schema-constrained LLM call, priced, capped, retried on transient errors and recorded.",
        "operationId": "llm_structured_llm_structured_post",
        "parameters": [
          {
            "description": "The same key again returns the stored answer instead of a new, charged call",
            "in": "header",
            "name": "Idempotency-Key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9:_-]{8,128}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The same key again returns the stored answer instead of a new, charged call",
              "title": "Idempotency-Key"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StructuredRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StructuredReply"
                }
              }
            },
            "description": "Successful Response"
          },
          "402": {
            "description": "Monthly budget cap reached"
          },
          "409": {
            "description": "A call with this Idempotency-Key is still running"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "description": "The account's daily quota of checks is used"
          }
        },
        "summary": "Llm Structured",
        "tags": [
          "llm"
        ]
      }
    },
